<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d"
			 Background="#F8FAFC"
			 d:DesignWidth="1400"
			 d:DesignHeight="1000"
			 xmlns:pg="using:FinanceProject"
			 x:DataType="pg:ExpenseContext"
			 xmlns:models="using:FinanceProject.Transaction"
			 xmlns:element="using:FinanceProject.Elements"
			 x:Class="FinanceProject.ExpenseContext">


	<UserControl.Styles>
		<Style Selector="DataGridColumnHeader">
			<Setter Property="Background" Value="#F1F3F5"/>
			<Setter Property="Foreground" Value="#6C757D"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Padding" Value="10,15"/>
		</Style>

		<Style Selector="DataGridCell">
			<Setter Property="Height" Value="50"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
		</Style>
	</UserControl.Styles>

	<Grid Margin="10" RowDefinitions="*, 5*">

		<Grid ColumnDefinitions="Auto,*">
			<Border Background="#FFFFFF" Width="400" Margin="0 10 0 0" CornerRadius="12" Height="130" Padding="5" BoxShadow="0 8 30 0 #30000000">
				<Grid ColumnDefinitions="* *">
					<StackPanel>
						<TextBlock Margin="5 25 0 0" Text="Soma das despesas" Foreground="#1150CE" FontWeight="Bold" FontSize="18"/>
						<TextBlock Margin="5 5 0 0" Text="{Binding TotalExpense, Mode=TwoWay}" Foreground="#fcba03" FontSize="28" FontWeight="Bold"/>
					</StackPanel>
					<PathIcon Grid.Column="1" Data="{StaticResource wallet}" Foreground="#fcba03" Height="50" Width="50"/>
				</Grid>
			</Border>

			<Grid Grid.Column="1" RowDefinitions="*,*">
				<StackPanel Margin="0 10 0 0">
					<element:ButtonElement
					x:Name="btnNewSalary"
					Width="200"
					Height="60"
					Margin="15"
					BackgroundColor="#fcba03"
					HoverColor="#ffcb3b"
					IconSize="24"
					IconPositionY="22"
					IconPositionX="11"
					HorizontalAlignment="Left"
					FontFamily="Arial"
					TextPositionX="40"
					TextPositionY="12"
					Text="Nova Despesa"
					CornerRadius="12"
					TextFontWeight="DemiBold"
					TextFontSize="24"
					TextFontColor="#FFFFFF"
						PointerPressed="BtnNewExpense_PointerPressed"
					Icon="{StaticResource add}"
					Theme="{StaticResource ButtonElementTheme}"/>
				</StackPanel>
			</Grid>
		</Grid>

		<Border Grid.Row="1" Margin="0 50 0 0" Background="#FFFFFF" CornerRadius="12" Padding="5" BoxShadow="0 8 30 0 #30000000">
			<DataGrid
			ItemsSource="{Binding Expenses, Mode=TwoWay}"
			AutoGenerateColumns="False"
			CanUserResizeColumns="True"
			GridLinesVisibility="None"
			HeadersVisibility="Column"
			SelectionMode="Single"
			RowBackground="White" >

				<DataGrid.Columns>
					<DataGridCheckBoxColumn x:DataType="models:TransactionFinance" Width="50" />
					<DataGridTextColumn x:DataType="models:TransactionFinance" IsReadOnly="True" Header="" Binding="{Binding Id}" Width="50" />
					<DataGridTextColumn x:DataType="models:TransactionFinance" IsReadOnly="True" Header="Categoria" Binding="{Binding Category}" Width="*" />

					<DataGridTemplateColumn Header="Quantia" Width="*" IsReadOnly="True">
						<DataGridTemplateColumn.CellTemplate>
							<DataTemplate x:DataType="models:TransactionFinance">
								<StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="5,0">
									<TextBlock Text="{Binding Amount}" VerticalAlignment="Center" />
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>

					<DataGridTextColumn x:DataType="models:TransactionFinance" IsReadOnly="True" Header="Data" Binding="{Binding Date}" Width="*" />
					<DataGridTextColumn x:DataType="models:TransactionFinance" IsReadOnly="True" Header="Descrição" Binding="{Binding Description}" Width="*" />

					<DataGridTemplateColumn Header="Editar/Deletar"  Width="Auto">
						<DataGridTemplateColumn.CellTemplate >
							<DataTemplate x:DataType="models:TransactionFinance">
								<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="10,0">
									<element:ButtonElement
									Width="32"
									Height="32"
									BackgroundColor="#1150ce"
									HoverColor="#0b3997"
									IconSize="14"
									IconPositionY="5"
									IconPositionX="7"
									HorizontalAlignment="Left"
									FontFamily="Arial"
									CornerRadius="8"
									TextFontWeight="DemiBold"
									TextFontSize="1"
									PointerPressed="OnEdit_PointerPressed"
									TextFontColor="#FFFFFF"
									Icon="{StaticResource edit}"
									Theme="{StaticResource ButtonElementTheme}"/>

									<element:ButtonElement
									Width="32"
									Height="32"
									BackgroundColor="#d52536"
									HoverColor="#b41c2b"
									IconSize="14"
									IconPositionY="5"
									IconPositionX="7"
									HorizontalAlignment="Left"
									FontFamily="Arial"
									CornerRadius="8"
									TextFontWeight="DemiBold"
									TextFontSize="1"
									PointerPressed="OnDelete_PointerPressed"
									TextFontColor="#FFFFFF"
									Icon="{StaticResource trash}"
									Theme="{StaticResource ButtonElementTheme}"/>
								</StackPanel>
							</DataTemplate>
						</DataGridTemplateColumn.CellTemplate>
					</DataGridTemplateColumn>
				</DataGrid.Columns>
			</DataGrid>
		</Border>
	</Grid>

</UserControl>