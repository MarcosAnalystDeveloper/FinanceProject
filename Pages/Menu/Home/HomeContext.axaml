<UserControl xmlns="https://github.com/avaloniaui"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
			 mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
			 xmlns:element="using:FinanceProject.Elements"
			 xmlns:ScottPlot="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
			 x:Class="FinanceProject.HomeContext"
			 xmlns:pg="using:FinanceProject"
			 x:DataType="pg:HomeContext">

	<ScrollViewer Padding="30">
		<Grid RowDefinitions="Auto, Auto, *" ColumnDefinitions="*, *">

			<StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,20">
				<TextBlock Text="Olá, Usuário 1" FontSize="24" FontWeight="Bold" Foreground="White"/>
				<TextBlock Text="Aqui está o resumo do seu mês." Foreground="#666666"/>
			</StackPanel>

			<Border Grid.Row="1" Grid.Column="0" Margin="10"
					Background="#1F222C"	CornerRadius="15" Padding="20">
				<StackPanel>
					<TextBlock Text="Salário mais alto" Foreground="#7FD9F9" FontSize="14"/>
					<TextBlock Text="R$ 15.000,00" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10"/>
				</StackPanel>
			</Border>

			<Border Grid.Row="1" Grid.Column="1" Margin="10"
					Background="#1F222C" CornerRadius="15" Padding="20">
				<StackPanel>
					<TextBlock Text="Despesa mais alta" Foreground="#F87171" FontSize="14"/>
					<TextBlock Text="R$ 4.200,00" Foreground="White" FontSize="28" FontWeight="Bold" Margin="0,10"/>
				</StackPanel>
			</Border>

			<Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
					Margin="10" Background="#1F222C" CornerRadius="15" Padding="20" MinHeight="400">
				<Grid RowDefinitions="Auto, *">
					<TextBlock Text="Análise Anual" FontWeight="SemiBold" Foreground="White" Margin="0,0,0,20"/>

					<Rectangle Grid.Row="1" Fill="#2D303E" Opacity="0.5" />
					<Grid RowDefinitions="Auto, *">

						<StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Right" Margin="0,0,20,10">
							<RadioButton x:Name="RbLinha" Content="Linha" IsChecked="True" Foreground="White"/>
							<RadioButton x:Name="RbPizza" Content="Setores (Pizza)" Foreground="White"/>
						</StackPanel>

					</Grid>
				</Grid>
			</Border>

		</Grid>
	</ScrollViewer>
</UserControl>